tyle=\"{{ navPricing }}\">Pricing<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<section id=\"scale\" data-sec=\"scale\" style=\"padding: 64px 0 88px;\">\n  <div style=\"max-width: 1230px; margin: 0 auto; padding: 0 24px;\">\n    <h2 style=\"font-family: 'Schibsted Grotesk', sans-serif; font-weight: 600; font-size: clamp(30px, 4vw, 50px); line-height: 1.1; letter-spacing: -0.03em; color: #0F172B; margin: 0 0 48px; text-align: center;\">More pipeline from the team you already have<\u002Fh2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;\">\n      <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 14px; padding: 32px 32px 0; display: flex; flex-direction: column; box-shadow: 0 2px 4px rgba(0,0,0,.04);\">\n        <h3 style=\"font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B; margin: 0 0 12px;\">Unlimited mailboxes &amp; storage<\u002Fh3>\n        <p style=\"font-size: 16px; line-height: 1.5; color: #45556C; margin: 0 0 28px;\">Connect as many senders as you need and keep every lead. You pay for what you send, not for what you store.<\u002Fp>\n        <div style=\"margin-top: auto; height: 272px; border-radius: 8px 8px 0 0; overflow: hidden; position: relative; background: radial-gradient(118% 84% at 50% 116%, rgba(139,107,255,.30) 0%, rgba(47,198,238,.13) 40%, rgba(255,255,255,0) 72%), radial-gradient(70% 100% at 0% 100%, rgba(255,111,197,.13) 0%, rgba(255,255,255,0) 62%), radial-gradient(70% 100% at 100% 100%, rgba(47,198,238,.14) 0%, rgba(255,255,255,0) 62%), linear-gradient(180deg,#FFFFFF 0%,#FCFBFF 100%); border: 1px solid #E6E3F0; border-bottom: none; padding: 14px 14px 0;\">\n          <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 10px;\">\n            <img src=\"6916b7cc-0a2d-4580-980e-30122e420e15\" alt=\"Gmail\" style=\"width: 18px; height: 18px; display: block;\">\n            <span style=\"font-size: 12px; font-weight: 600; color: #45556C;\">142 mailboxes connected<\u002Fspan>\n            <span style=\"margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; color: #05D17F;\"><span style=\"width: 6px; height: 6px; border-radius: 50%; background: #05D17F; display: block; animation: pulseDot 1.8s ease-in-out infinite;\"><\u002Fspan>Live<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"position: relative; height: 218px; overflow: hidden; -webkit-mask-image: linear-gradient(180deg,transparent 0%,#000 9%,#000 62%,transparent 100%); mask-image: linear-gradient(180deg,transparent 0%,#000 9%,#000 62%,transparent 100%);\">\n            <div style=\"display: flex; flex-direction: column; gap: 8px; animation: listUp 16s linear infinite; will-change: transform;\">\n              <div style=\"display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 10px;\"><img src=\"81580bce-50d6-4077-93ff-73183df645b1\" alt=\"\" style=\"width: 26px; height: 26px; border-radius: 50%; object-fit: cover; display: block; flex: none;\"><span style=\"min-width: 0;\"><span style=\"display: block; font-size: 12.5px; font-weight: 600; color: #0F172B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Olivia Bennett<\u002Fspan><span style=\"display: block; font-size: 11px; color: #65768D;\">GTM Operations<\u002Fspan><\u002Fspan><span style=\"margin-left: auto; width: 22px; height: 22px; border-radius: 5px; background: #F1EEF8; border: 1px solid #CDF1E3; flex: none;\"><\u002Fspan><\u002Fdiv>\n              <div style=\"display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 10px;\"><img src=\"8b2419df-8ce0-4c03-bfdb-fcd66b8fab90\" alt=\"\" style=\"width: 26px; height: 26px; border-radius: 50%; object-fit: cover; display: block; flex: none;\"><span style=\"min-width: 0;\"><span style=\"display: bloc