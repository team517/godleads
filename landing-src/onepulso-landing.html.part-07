size: 12.5px; font-weight: 600; color: #0F172B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Michael Carter<\u002Fspan><span style=\"display: block; font-size: 11px; color: #65768D;\">Sales Director<\u002Fspan><\u002Fspan><span style=\"margin-left: auto; width: 22px; height: 22px; border-radius: 5px; background: #F1EEF8; border: 1px solid #CDF1E3; flex: none;\"><\u002Fspan><\u002Fdiv>\n              <div style=\"display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 10px;\"><img src=\"2b05b496-157f-4b01-b3a6-12e88d92d98e\" alt=\"\" style=\"width: 26px; height: 26px; border-radius: 50%; object-fit: cover; display: block; flex: none;\"><span style=\"min-width: 0;\"><span style=\"display: block; font-size: 12.5px; font-weight: 600; color: #0F172B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Hailey Rogers<\u002Fspan><span style=\"display: block; font-size: 11px; color: #65768D;\">Marketing Manager<\u002Fspan><\u002Fspan><span style=\"margin-left: auto; width: 22px; height: 22px; border-radius: 5px; background: #F1EEF8; border: 1px solid #CDF1E3; flex: none;\"><\u002Fspan><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 14px; padding: 32px 32px 0; display: flex; flex-direction: column; box-shadow: 0 2px 4px rgba(0,0,0,.04);\">\n        <h3 style=\"font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B; margin: 0 0 12px;\">Setup and warmup included<\u002Fh3>\n        <p style=\"font-size: 16px; line-height: 1.5; color: #45556C; margin: 0 0 28px;\">DNS records, sender rotation and warmup run on their own from the day a domain is added.<\u002Fp>\n        <div style=\"margin-top: auto; height: 272px; border-radius: 8px 8px 0 0; overflow: hidden; position: relative; background: radial-gradient(118% 84% at 50% 116%, rgba(139,107,255,.30) 0%, rgba(47,198,238,.13) 40%, rgba(255,255,255,0) 72%), radial-gradient(70% 100% at 0% 100%, rgba(255,111,197,.13) 0%, rgba(255,255,255,0) 62%), radial-gradient(70% 100% at 100% 100%, rgba(47,198,238,.14) 0%, rgba(255,255,255,0) 62%), linear-gradient(180deg,#FFFFFF 0%,#FCFBFF 100%); border: 1px solid #E6E3F0; border-bottom: none; padding: 14px 14px 0; display: flex; flex-direction: column; align-items: center;\">\n          <svg sc-camel-view-box=\"0 0 200 118\" style=\"width: 206px; height: 118px; display: block; flex: none;\">\n            <defs>\n              <linearGradient id=\"pl-gauge\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                <stop offset=\"0%\" stop-color=\"#2FC6EE\"><\u002Fstop>\n                <stop offset=\"52%\" stop-color=\"#8B6BFF\"><\u002Fstop>\n                <stop offset=\"100%\" stop-color=\"#FF6FC5\"><\u002Fstop>\n              <\u002FlinearGradient>\n            <\u002Fdefs>\n            <path d=\"M10,100 A90,90 0 0 1 190,100\" fill=\"none\" stroke=\"#E4E0F2\" stroke-width=\"13\" stroke-linecap=\"round\"><\u002Fpath>\n            <path d=\"M10,100 A90,90 0 0 1 190,100\" fill=\"none\" stroke=\"url(#pl-gauge)\" stroke-width=\"13\" stroke-linecap=\"round\" stroke-dasharray=\"283\" style=\"stroke-dashoffset: 283; animation: gaugeSweep 7s cubic-bezier(.4,0,.2,1) infinite;\"><\u002Fpath>\n            <g style=\"transform-origin: 100px 100px; transform-box: view-box; animation: needleSweep 7s cubic-bezier(.4,0,.2,1) infinite;\">\n              <line x1=\"100\" y1=\"100\" x2=\"100\" y2=\"60\" stroke=\"#B9CFE8\" stroke-width=\"5\" stroke-linecap=\"round\"><\u002Fline>\n              <circle cx=\"100\" cy=\"58\" r=\"8\" fill=\"#3B89E9\"><\u002Fcircle>\n            <\u002Fg>\n            <circle cx=\"100\" cy=\"100\" r=\"11\" fill=\"#fff\" stroke=\"#DCE9F5\" stroke-width=\"3\"><\u002Fcircle>\n          <\u002Fsvg>\n          <div style=\"display: flex; align-items: baseline; gap: 8px; margin-top: 2px;\">\n            <span style=\"height: 29px; overflow: hidden; display: block;\">\n              <span style=\"display: block; animation: numStrip 7s steps(4, end) infinite; will-change: transform;\">\n                <span style=\"display: block; height: 29px; line-height: 29px; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; color: #0F172B;\">12%<\u002Fspan>\n                <span style=\"display: block; height: 29px; line-height: 29px; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; color: #0F172B;\">31%<\u002Fspan>\n                <span style=\"display: block; height: 29px; line-height: 29px; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; color: #0F172B;\">48%<\u002Fspan>\n                <span style=\"display: block; height: 29px; line-height: 29px; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; color: #0F172B;\">66%<\u002Fspan>\n                <span style=\"display: block; height: 29px; line-height: 29px; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; color: #0F172B;\">78%<\u002Fspan>\n              <\u002Fspan>\n            <\u002Fspan>\n            <span style=\"font-size: 12.5px; color: #45556C;\">inbox placement<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"font-size: 12px; color: #65768D; margin: 2px 0 12px;\">Slow ramp in progress<\u002Fdiv>\n          <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%;\">\n            <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 9px; animation: riseIn 7s ease-in-out .2s infinite;\">\n              <span style=\"display: flex; align-items: center; gap: 5px; margin-bottom: 4px;\"><img src=\"f3cfe9c3-28de-4ac5-9e4a-ed7663d1e901\" alt=\"\" style=\"width: 12px; height: 12px; display: block;\"><span style=\"font-size: 10.5px; font-weight: 600; color: #45556C;\">Day 1<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; font-weight: 600; color: #05A063;\">Good<\u002Fspan><\u002Fspan>\n              <span style=\"display: block; font-size: 16px; font-weight: 600; color: #0F172B; letter-spacing: -0.02em;\">10%<\u002Fspan>\n              <span style=\"display: block; font-size: 10.5px; color: #65768D;\">12 emails<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 9px; animation: riseIn 7s ease-in-out .9s infinite;\">\n              <span style=\"display: flex; align-items: center; gap: 5px; margin-bottom: 4px;\"><img src=\"f3cfe9c3-28de-4ac5-9e4a-ed7663d1e901\" alt=\"\" style=\"width: 12px; height: 12px; display: block;\"><span style=\"font-size: 10.5px; font-weight: 600; color: #45556C;\">Day 3<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; font-weight: 600; color: #05A063;\">Good<\u002Fspan><\u002Fspan>\n              <span style=\"display: block; font-size: 16px; font-weight: 600; color: #0F172B; letter-spacing: -0.02em;\">28%<\u002Fspan>\n              <span style=\"display: block; font-size: 10.5px; color: #65768D;\">30 emails<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 8px 9px; animation: riseIn 7s ease-in-out 1.6s infinite;\">\n              <span style=\"display: flex; align-items: center; gap: 5px; margin-bottom: 4px;\"><img src=\"f3cfe9c3-28de-4ac5-9e4a-ed7663d1e901\" alt=\"\" style=\"width: 12px; height: 12px; display: block;\"><span style=\"font-size: 10.5px; font-weight: 600; color: #45556C;\">Day 5<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; font-weight: 600; color: #05A063;\">Good<\u002Fspan><\u002Fspan>\n              <span style=\"display: block; font-size: 16px; font-weight: 600; color: #0F172B; letter-spacing: -0.02em;\">54%<\u002Fspan>\n              <span style=\"display: block; font-size: 10.5px; color: #65768D;\">60 emails<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 14px; padding: 32px 32px 0; display: flex; flex-direction: column; box-shadow: 0 2px 4px rgba(0,0,0,.04);\">\n        <h3 style=\"font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B; margin: 0 0 12px;\">Time back for closing<\u002Fh3>\n        <p style=\"font-size: 16px; line-height: 1.5; color: #45556C; margin: 0 0 28px;\">Senders, lists and replies sit in one place, so the team spends its hours on conversations instead of admin.<\u002Fp>\n        <div style=\"margin-top: auto; height: 272px; border-radius: 8px 8px 0 0; overflow: hidden; position: relative; background: radial-gradient(118% 84% at 50% 116%, rgba(139,107,255,.30) 0%, rgba(47,198,238,.13) 40%, rgba(255,255,255,0) 72%), radial-gradient(70% 100% at 0% 100%, rgba(255,111,197,.13) 0%, rgba(255,255,255,0) 62%), radial-gradient(70% 100% at 100% 100%, rgba(47,198,238,.14) 0%, rgba(255,255,255,0) 62%), linear-gradient(180deg,#FFFFFF 0%,#FCFBFF 100%); border: 1px solid #E6E3F0; border-bottom: none; padding: 14px 14px 0;\">\n          <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 8px 8px 0 0; padding: 12px; height: 100%; box-shadow: 0 -2px 10px rgba(21,17,60,.04);\">\n            <div style=\"display: flex; align-items: center; gap: 8px; padding-bottom: 10px; border-bottom: 1px solid #EAE7F4;\">\n              <img src=\"6916b7cc-0a2d-4580-980e-30122e420e15\" alt=\"Gmail\" style=\"width: 17px; height: 17px; display: block;\">\n              <span style=\"font-size: 13px; font-weight: 600; color: #0F172B;\">Master Inbox<\u002Fspan>\n              <span style=\"margin-left: auto; font-size: 10.5px; font-weight: 600; color: #6E58F1; background: #F1EEF8; padding: 3px 8px; border-radius: 999px;\">4 new<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"display: flex; flex-direction: column; gap: 8px; padding-top: 10px;\">\n              <div style=\"border: 1px solid #DAD4F7; background: #FCFBFF; border-radius: 6px; padding: 9px 10px; animation: riseIn 8s ease-in-out .2s infinite;\">\n                <span style=\"display: flex; align-items: center; gap: 8px;\"><span style=\"font-size: 12.5px; font-weight: 600; color: #0F172B;\">Quick question<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; font-weight: 600; color: #fff; background: #3B89E9; padding: 3px 7px; border-radius: 4px; animation: badgePop 8s ease-in-out .9s infinite;\">Lead replied<\u002Fspan><\u002Fspan>\n                <span style=\"display: block; margin-top: 4px; font-size: 11.5px; color: #65768D; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Hi Ryan, yes — outbound is something we…<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"border: 1px solid #E6E3F0; border-radius: 6px; padding: 9px 10px; animation: riseIn 8s ease-in-out 1.4s infinite;\">\n                <span style=\"display: flex; align-items: center; gap: 8px;\"><img src=\"99045165-c014-4444-8177-4433b57a30d1\" alt=\"\" style=\"width: 22px; height: 22px; border-radius: 50%; object-fit: cover; display: block; flex: none;\"><span style=\"font-size: 12px; font-weight: 600; color: #0F172B;\">Michael Thompson<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; color: #7E7A93;\">08:24<\u002Fspan><\u002Fspan>\n                <span style=\"display: block; margin-top: 4px; font-size: 11.5px; color: #65768D; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Re: worth a look — send times?<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"border: 1px solid #E6E3F0; border-radius: 6px; padding: 9px 10px; animation: riseIn 8s ease-in-out 2.6s infinite;\">\n                <span style=\"display: flex; align-items: center; gap: 8px;\"><img src=\"81580bce-50d6-4077-93ff-73183df645b1\" alt=\"\" style=\"width: 22px; height: 22px; border-radius: 50%; object-fit: cover; display: block; flex: none;\"><span style=\"font-size: 12px; font-weight: 600; color: #0F172B;\">Olivia Bennett<\u002Fspan><span style=\"margin-left: auto; font-size: 10px; font-weight: 600; color: #05A063; background: #F1EEF8; padding: 3px 7px; border-radius: 4px;\">Interested<\u002Fspan><\u002Fspan>\n                <span style=\"display: block; margin-top: 4px; font-size: 11.5px; color: #65768D; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">Can you do Thursday morning?<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  \n<\u002Fsection>\n\n<section id=\"infra\" data-sec=\"infra\" style=\"padding: 24px 0 96px;\">\n  <div style=\"max-width: 1230px; margin: 0 auto; padding: 0 24px;\">\n    <div style=\"display: flex; flex-direction: column; align-items: center; gap: 20px; margin-bottom: 48px;\">\n      <span style=\"background: #fff; border: 1px solid #E6E3F0; color: #6E58F1; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 999px; box-shadow: 0 2px 4px rgba(0,0,0,.05);\">Infrastructure<\u002Fspan>\n      <h2 style=\"font-family: 'Schibsted Grotesk', sans-serif; font-weight: 600; font-size: clamp(30px, 4vw, 50px); line-height: 1.1; letter-spacing: -0.03em; color: #0F172B; margin: 0; text-align: center; text-wrap: balance;\">A sending engine built for cold outreach<\u002Fh2>\n    <\u002Fdiv>\n    <div style=\"display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: 64px; align-items: center;\">\n      <div style=\"display: flex; flex-direction: column;\">\n        <div sc-camel-on-click=\"{{ tab0 }}\" style=\"padding: 24px 0; border-bottom: 1px solid #EAE7F4; cursor: pointer;\">\n          <div style=\"{{ ta0 }}\">\n            <div style=\"position: relative; padding-bottom: 14px; display: flex; align-items: center; gap: 12px;\">\n              <span style=\"width: 9px; height: 9px; border-radius: 50%; background: #6E58F1; flex: none;\"><\u002Fspan>\n              <span style=\"font-size: 19px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B;\">Your sender reputation stays yours<\u002Fspan>\n              <span style=\"position: absolute; left: 0; bottom: 0; width: 100%; height: 2px; background: rgba(15,23,43,.06);\"><span style=\"{{ tw0 }}\"><\u002Fspan><\u002Fspan>\n            <\u002Fdiv>\n            <p style=\"margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: #45556C;\">Dedicated IPs and single-tenant servers mean no one else's sending habits touch your deliverability.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div sc-camel-on-click=\"{{ tab1 }}\" style=\"padding: 24px 0; border-bottom: 1px solid #EAE7F4; cursor: pointer;\">\n          <div style=\"{{ ta1 }}\">\n            <div style=\"position: relative; padding-bottom: 14px; display: flex; align-items: center; gap: 12px;\">\n              <span style=\"width: 9px; height: 9px; border-radius: 50%; background: #3B89E9; flex: none;\"><\u002Fspan>\n              <span style=\"font-size: 19px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B;\">Warm-up that never stops<\u002Fspan>\n              <span style=\"position: absolute; left: 0; bottom: 0; width: 100%; height: 2px; background: rgba(15,23,43,.06);\"><span style=\"{{ tw1 }}\"><\u002Fspan><\u002Fspan>\n            <\u002Fdiv>\n            <p style=\"margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: #45556C;\">Every new domain ramps over three weeks and keeps warming underneath live campaigns, so volume climbs without spam flags.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div sc-camel-on-click=\"{{ tab2 }}\" style=\"padding: 24px 0; border-bottom: 1px solid #EAE7F4; cursor: pointer;\">\n          <div style=\"{{ ta2 }}\">\n            <div style=\"position: relative; padding-bottom: 14px; display: flex; align-items: center; gap: 12px;\">\n              <span style=\"width: 9px; height: 9px; border-radius: 50%; background: #05D17F; flex: none;\"><\u002Fspan>\n              <span style=\"font-size: 19px; font-weight: 600; letter-spacing: -0.02em; color: #0F172B;\">Volume spread across every mailbox<\u002Fspan>\n              <span style=\"position: absolute; left: 0; bottom: 0; width: 100%; height: 2px; background: rgba(15,23,43,.06);\"><span style=\"{{ tw2 }}\"><\u002Fspan><\u002Fspan>\n            <\u002Fdiv>\n            <p style=\"margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: #45556C;\">A campaign rotates itself across all connected senders, pacing each one so no mailbox carries more than it should.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"background: linear-gradient(135deg,#2FC6EE 0%,#8B6BFF 52%,#FF6FC5 100%); padding: 1.6px; border-radius: 16px; box-shadow: 0 14px 36px rgba(21,17,60,.09);\"><div style=\"position: relative; height: 556px; border-radius: 14.4px; overflow: hidden; background: #fff;\">\n        <div style=\"{{ tv0 }}\">\n          <div style=\"height: 100%; padding: 28px 30px; display: flex; flex-direction: column; background: radial-gradient(118% 84% at 50% 116%, rgba(139,107,255,.30) 0%, rgba(47,198,238,.13) 40%, rgba(255,255,255,0) 72%), radial-gradient(70% 100% at 0% 100%, rgba(255,111,197,.13) 0%, rgba(255,255,255,0) 62%), radial-gradient(70% 100% at 100% 100%, rgba(47,198,238,.14) 0%, rgba(255,255,255,0) 62%), linear-gradient(180deg,#FFFFFF 0%,#FCFBFF 100%);\">\n            <div style=\"display: flex; align-items: center; margin-bottom: 6px;\">\n              <span style=\"font-size: 15px; font-weight: 600; color: #0F172B;\">Sender reputation<\u002Fspan>\n              <span style=\"margin-left: auto; font-size: 12px; font-weight: 600; color: #05A063; background: #F1EEF8; border: 1px solid #CDF1E3; padding: 4px 10px; border-radius: 999px;\">Excellent<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"position: relative; display: flex; align-items: center; justify-content: center; height: 212px;\">\n              <span style=\"position: absolute; width: 176px; height: 176px; border-radius: 50%; background: radial-gradient(circle, rgba(110,88,241,.32) 0%, rgba(110,88,241,0) 70%); animation: glowPulse 4s ease-in-out infinite;\"><\u002Fspan>\n              <svg sc-camel-view-box=\"0 0 160 160\" style=\"width: 184px; height: 184px; display: block; position: relative;\">\n                <defs>\n                  <linearGradient id=\"pl-ring\" x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\n                    <stop offset=\"0%\" stop-color=\"#2FC6EE\"><\u002Fstop>\n                    <stop offset=\"52%\" stop-color=\"#8B6BFF\"><\u002Fstop>\n                    <stop offset=\"100%\" stop-color=\"#FF6FC5\"><\u002Fstop>\n                  <\u002FlinearGradient>\n                <\u002Fdefs>\n                <circle cx=\"80\" cy=\"80\" r=\"65\" fill=\"none\" stroke=\"#EFEDF7\" stroke-width=\"14\"><\u002Fcircle>\n                <circle cx=\"80\" cy=\"80\" r=\"65\" fill=\"none\" stroke=\"url(#pl-ring)\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-dasharray=\"408\" style=\"stroke-dashoffset: 408; transform: rotate(-90deg); transform-origin: 80px 80px; transform-box: view-box; animation: ringDraw 7s cubic-bezier(.4,0,.2,1) infinite;\"><\u002Fcircle>\n              <\u002Fsvg>\n              <span style=\"position: absolute; text-align: center;\">\n                <span style=\"display: block; font-family: 'Schibsted Grotesk', sans-serif; font-size: 46px; font-weight: 600; letter-spacing: -0.04em; color: #0F172B; line-height: 1;\">98<\u002Fspan>\n                <span style=\"display: block; font-size: 12.5px; color: #65768D; margin-top: 4px;\">out of 100<\u002Fspan>\n              <\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"margin-top: 4px;\">\n              <span style=\"display: block; font-size: 12.5px; color: #65768D; margin-bottom: 6px;\">Last 30 days<\u002Fspan>\n              <svg sc-camel-view-box=\"0 0 320 84\" sc-camel-preserve-aspect-ratio=\"none\" style=\"width: 100%; height: 104px; display: block;\">\n                <defs>\n                  <linearGradient id=\"pl-area\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stop-color=\"#8B6BFF\" stop-opacity=\".24\"><\u002Fstop>\n                    <stop offset=\"100%\" stop-color=\"#8B6BFF\" stop-opacity=\"0\"><\u002Fstop>\n                  <\u002FlinearGradient>\n                <\u002Fdefs>\n                <path d=\"M0,70 L0,62 C26,58 38,52 62,48 C92,43 104,50 128,42 C156,33 168,30 196,24 C226,18 240,20 268,14 C292,9 306,8 320,6 L320,84 L0,84 Z\" fill=\"url(#pl-area)\" style=\"animation: areaIn 7s ease-in-out infinite;\"><\u002Fpath>\n                <path d=\"M0,62 C26,58 38,52 62,48 C92,43 104,50 128,42 C156,33 168,30 196,24 C226,18 240,20 268,14 C292,9 306,8 320,6\" fill=\"none\" stroke=\"#6E58F1\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-dasharray=\"640\" style=\"stroke-dashoffset: 640; animation: lineDraw 7s cubic-bezier(.4,0,.2,1) infinite;\"><\u002Fpath>\n              <\u002Fsvg>\n            <\u002Fdiv>\n            <div style=\"margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;\">\n              <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 10px 12px;\"><span style=\"display: block; font-size: 11.5px; color: #65768D;\">Bounce<\u002Fspan><span style=\"display: block; font-size: 17px; font-weight: 600; color: #0F172B; letter-spacing: -0.02em;\">0.4%<\u002Fspan><\u002Fdiv>\n              <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 10px 12px;\"><span style=\"display: block; font-size: 11.5px; color: #65768D;\">Spam rate<\u002Fspan><span style=\"display: block; font-size: 17px; font-weight: 600; color: #0F172B; letter-spacing: -0.02em;\">0.02%<\u002Fspan><\u002Fdiv>\n              <div style=\"background: #fff; border: 1px solid #E6E3F0; border-radius: 6px; padding: 10px 12px;\"><s