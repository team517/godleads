acity: 0; transform: scale(.82); } }\n  @media (max-width: 760px) { [data-inboxwrap] { margin-right: 0 !important; } }\n  @media (max-width: 1040px) { [data-tzgrid] { grid-template-columns: minmax(0, 1fr) !important; gap: 36px !important; } }\n  @media (max-width: 1100px) { [data-inboxgrid] { grid-template-columns: minmax(0, 1fr) !important; gap: 32px !important; } [data-inboxwrap] { margin-right: -24px !important; } [data-inboxfeats] { display: grid !important; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)) !important; } }\n  @media (max-width: 1140px) { [data-connector] { display: none !important; } [data-flowrow] { gap: 18px !important; } [data-stage] { flex: 1 1 calc(50% - 9px) !important; } }\n  @media (max-width: 560px) { [data-stage] { flex: 1 1 100% !important; } }\n  @keyframes ring64 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 50; } 100% { stroke-dashoffset: 138; } }\n  @keyframes ring40 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 83; } 100% { stroke-dashoffset: 138; } }\n  @keyframes ring86 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 19; } 100% { stroke-dashoffset: 138; } }\n  @keyframes ring36 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 88; } 100% { stroke-dashoffset: 138; } }\n  @keyframes ring20 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 110; } 100% { stroke-dashoffset: 138; } }\n  @keyframes ring58 { 0% { stroke-dashoffset: 138; } 40%, 92% { stroke-dashoffset: 58; } 100% { stroke-dashoffset: 138; } }\n  @keyframes typeDot { 0%, 60%, 100% { opacity: .25; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }\n  @keyframes aiScan { 0% { transform: translateY(-12px); opacity: 0; } 18%, 62% { opacity: 1; } 100% { transform: translateY(94px); opacity: 0; } }\n  @keyframes flyToInbox { 0% { transform: translate(0,0) scale(.94); opacity: 0; } 14% { opacity: 1; } 70% { transform: translate(126px,-4px) scale(1); opacity: 1; } 84%, 100% { transform: translate(126px,-4px) scale(1); opacity: 0; } }\n  @keyframes shieldFlash { 0%, 100% { box-shadow: 0 0 0 0 rgba(5,209,127,0); } 50% { box-shadow: 0 0 0 8px rgba(5,209,127,.16); } }\n  @keyframes stepIn { 0% { opacity: 0; transform: translateY(14px); } 5%, 90% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-8px); } }\n  @keyframes barFill { 0% { width: 0; } 18%, 90% { width: 100%; } 100% { width: 100%; } }\n  @keyframes spin { to { transform: rotate(360deg); } }\n  @keyframes caretBlink { 0%, 45% { opacity: 1; } 46%, 100% { opacity: 0; } }\n  @keyframes pulseAcross { 0% { left: 0; opacity: 0; } 1% { opacity: 1; } 7% { left: 100%; opacity: 1; } 9%, 100% { left: 100%; opacity: 0; } }\n  @keyframes rowPop { 0% { opacity: 0; transform: translateX(-10px); } 100% { opacity: 1; transform: translateX(0); } }\n  @keyframes chipPop { 0% { opacity: 0; transform: scale(.7); } 100% { opacity: 1; transform: scale(1); } }\n  @keyframes rowSel { 0%, 2% { background: #FFFFFF; border-color: #EAE7F4; } 5%, 30% { background: #F7F5FE; border-color: #8B6BFF; } 33%, 100% { background: #FFFFFF; border-color: #EAE7F4; } }\n  @keyframes paneOn { 0%, 2% { opacity: 0; transform: translateY(8px); } 6%, 30% { opacity: 1; transform: translateY(0); } 34%, 100% { opacity: 0; transform: translateY(-6px); } }\n  @keyframes threadIn { 0%, 8% { opacity: 0; transform: translateY(10px); } 18%, 90% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(10px); } }\n  @keyframes railFill { 0% { width: 0; } 96%, 100% { width: 100%; } }\n  @keyframes stageOn { 0% { opacity: .5; border-color: #E8E5F2; box-shadow: 0 2px 4px rgba(0,0,0,.04); transform: translateY(0); } 5%, 23% { opacity: 1; border-color: #C9BFFA; box-shadow: 0 14px 32px rgba(110,88,241,.14); transform: translateY(-5px); } 31%, 100% { opacity: .5; border-color: #E8E5F2; box-shadow: 0 2px 4px rgba(0,0,0,.04); transform: translateY(0); } }\n  @keyframes numOn { 0% { background: #F1EEF8; color: #6E58F1; } 5%, 23% { background: #6E58F1; color: #FFFFFF; } 31%, 100% { background: #F1EEF8; color: #6E58F1; } }\n  @keyframes popIn { 0% { opacity: 0; transform: scale(.6); } 3%, 22% { opacity: 1; transform: scale(1); } 29%, 100% { opacity: 0; transform: scale(.6); } }\n  @keyframes countUp { 0% { transform: translateY(10px); opacity: 0; } 16%, 94% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(10px); opacity: 0; } }\n  @keyframes ringDraw { 0% { stroke-dashoffset: 408; } 42%, 92% { stroke-dashoffset: 24; } 100% { stroke-dashoffset: 408; } }\n  @keyframes lineDraw { 0% { stroke-dashoffset: 640; } 48%, 92% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 640; } }\n  @keyframes areaIn { 0%, 14% { opacity: 0; } 58%, 92% { opacity: 1; } 100% { opacity: 0; } }\n  @keyframes barGrow { 0% { transform: scaleY(.05); } 46%, 92% { transform: scaleY(1); } 100% { transform: scaleY(.05); } }\n  @keyframes travelX { 0% { left: 0; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { left: 100%; opacity: 0; } }\n  @keyframes travelY { 0% { top: 0; opacity: 0; } 14% { opacity: 1; } 86% { opacity: 1; } 100% { top: 100%; opacity: 0; } }\n  @keyframes glowPulse { 0%, 100% { opacity: .22; transform: scale(.9); } 50% { opacity: .5; transform: scale(1.14); } }\n  @keyframes deliverIn { 0%, 6% { opacity: 0; transform: translateX(16px); } 20%, 92% { opacity: 1; transform: translateX(0); } 100% { opacity: 0; transform: translateX(16px); } }\n  @keyframes dashMove { to { background-position: 20px 0; } }\n  @keyframes replyIn { 0% { opacity: 0; transform: translateX(20px); } 12%, 90% { opacity: 1; transform: translateX(0); } 100% { opacity: 0; transform: translateX(20px); } }\n  @keyframes checkIn { 0%, 6% { opacity: 0; transform: scale(.5); } 16%, 92% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(.5); } }\n  @keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }\n  @keyframes provLift { 0%, 2% { opacity: 0; transform: scale(1); } 8%, 27% { opacity: 1; transform: scale(1.09); } 32%, 100% { opacity: 0; transform: scale(1); } }\n  @keyframes flagPop { 0%, 4% { opacity: 0; transform: scale(1); } 8%, 16% { opacity: 1; transform: scale(1.34); } 22%, 100% { opacity: 0; transform: scale(1); } }\n  @keyframes tagPop { 0%, 5% { opacity: 0; transform: translate(-50%, 6px); } 8%, 15% { opacity: 1; transform: translate(-50%, 0); } 20%, 100% { opacity: 0; transform: translate(-50%, 4px); } }\n  @keyframes clockTick { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }\n  @keyframes tzRow { 0%, 6% { opacity: 0; transform: translateY(8px); } 14%, 92% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-6px); } }\n  @keyframes pulseDot { 0%, 100% { opacity: .35; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<sc-if value=\"{{ showBanner }}\" hint-placeholder-val=\"{{ true }}\">\n<div style=\"background: linear-gradient(270deg,#6B4FE0 0%,#33298F 22%,#33298F 78%,#6B4FE0 100%); color: #fff; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 11px 24px; font-size: 14px; font-weight: 500; letter-spacing: -0.01em;\">\n  <span>Warmup is now unlimited on every plan. No per-mailbox fees.<\u002Fspan>\n  <a href=\"#pricing\" style=\"color: #fff; font-weight: 600; white-space: nowrap;\">Start now →<\u002Fa>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n\n\n<header style=\"position: sticky; top: 0; z-index: 30; background: rgba(250,248,244,.9); backdrop-filter: blur(8px); border-bottom: 1px solid #EAE7F4;\">\n  <div style=\"max-width: 1230px; margin: 0 auto; padding: 0 24px; height: 68px; display: flex; align-items: center; gap: 40px;\">\n    <a href=\"#top\" style=\"display: flex; align-items: center; gap: 9px; color: #0F172B;\">\n      <img src=\"d9e35f00-9944-48c7-a125-23e70065276e\" alt=\"onepulso\" style=\"height: 30px; width: auto; display: block;\">\n    <\u002Fa>\n    <nav style=\"display: flex; align-items: center; gap: 4px; font-size: 15px; color: #1D293D; font-weight: 500; flex: 1;\">\n      <a href=\"#scale\" style=\"color: #1D293D; padding: 6px 10px; border-radius: 4px;\" style-hover=\"background: #F1EEF8;\">Product<\u002Fa>\n      <a href=\"#deliverability\" style=\"color: #1D293D; padding: 6px 10px; border-radius: 4px;\" style-hover=\"background: #F1EEF8;\">AI replies<\u002Fa>\n      <a href=\"#pricing\" style=\"color: #1D293D; padding: 6px 10px; border-radius: 4px;\" style-hover=\"background: #F1EEF8;\">Pricing<\u002Fa>\n      <a href=\"#faq\" style=\"color: #1D293D; padding: 6px 10px; border-radius: 4px;\" style-hover=\"background: #F1EEF8;\">Resources<\u002Fa>\n    <\u002Fnav>\n    <div style=\"display: flex; align-items: center; gap: 12px;\">\n      <a href=\"#login\" style=\"color: #45556C; font-size: 15px; font-weight: 500;\">Log in<\u002Fa>\n      <a href=\"#demo\" style=\"font-size: 15px; font-weight: 600; color: #0F172B; border: 1px solid #D4D0E2; background: #fff; padding: 9px 16px; border-radius: 6px;\" style-hover=\"border-color: #6E58F1; color: #6E58F1;\">Book a demo<\u002Fa>\n      <a href=\"#signup\" style=\"font-size: 15px; font-weight: 600; color: #fff; background: #6E58F1; padding: 10px 18px; border-radius: 6px; box-shadow: 0 2px 4px rgba(110,88,241,.24);\" style-hover=\"background: #5B40FB;\">Start free<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fheader>\n\n<section id=\"top\" style=\"position: relative; margin: 12px 12px 0; border-radius: 20px; overflow: hidden; background: #312A63; background-image: radial-gradient(120% 90% at 50% 0%, rgba(160,138,255,.52) 0%, rgba(12,21,18,0) 62%), linear-gradient(180deg, rgba(167,139,250,.09) 0%, rgba(12,21,18,0) 40%); padding: 92px 0 0;\">\n  <div style=\"max-width: 1230px; margin: 0 auto; padding: 0 24px; text-align: center;\">\n    <h1 style=\"font-family: 'Schibsted Grotesk', sans-serif; font-weight: 600; font-size: clamp(40px, 6vw, 76px); line-height: 1.05; letter-spacing: -0.035em; color: #FFFFFF; margin: 0 0 24px; text-wrap: balance;\">\n      <span style=\"display: block;\"><span style=\"display: inline-block; animation: blurFadeIn .7s .05s both;\">Turn&nbsp;<\u002Fspan><span style=\"display: inline-block; animation: blurFadeIn .7s .14s both;\">cold&nbsp;<\u002Fspan><span style=\"display: inline-block; animation: blurFadeIn .7s .23s both;\">email&nbsp;<\u002Fspan><span style=\"display: inline-block; animation: blurFadeIn .7s .32s both;\">into<\u002Fspan><\u002Fspan>\n      <span style=\"display: block;\"><span style=\"display: inline-block; animation: blurFadeIn .7s .44s both; color: #FFFFFF;\">booked&nbsp;<\u002Fspan><span style=\"display: inline-block; animation: blurFadeIn .7s .56s both; background: linear-gradient(90deg,#7DE3FF 0%,#B79BFF 52%,#FF9BE0 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;\">revenue<\u002Fspan><\u002Fspan>\n    <\u002Fh1>\n    <p style=\"max-width: 660px; margin: 0 auto 32px; font-size: 18px; line-height: 1.55; color: #E0DCFA;\">Your emails reach the primary inbox instead of spam, and the replies get answered and booked for you. More meetings from the same list, without hiring anyone.<\u002Fp>\n    <div style=\"display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;\">\n      <a href=\"#demo\" style=\"font-size: 16px; font-weight: 600; color: #EDEAFA; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.22); padding: 13px 24px; border-radius: 8px;\" style-hover=\"background: rgba(255,255,255,.12); border-color: rgba(167,139,250,.55);\">See it in action<\u002Fa>\n      <a href=\"#signup\" style=\"font-size: 16px; font-weight: 600; color: #FFFFFF; background: #6E58F1; padding: 14px 26px; border-radius: 8px; box-shadow: 0 6px 18px rgba(110,88,241,.38);\" style-hover=\"background: #7F6BFF;\">Start free trial<\u002Fa>\n    <\u002Fdiv>\n    <p style=\"margin: 16px 0 0; font-size: 14px; color: 