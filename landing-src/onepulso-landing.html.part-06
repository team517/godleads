; } to { opacity: 1; filter: blur(0); transform: translateY(0); } }\n  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n  @keyframes marqueeRev { from { transform: translateX(-50%); } to { transform: translateX(0); } }\n  @keyframes logoCycle { 0%,42% { opacity: 1; transform: translateY(0); } 50%,92% { opacity: 0; transform: translateY(-14px); } 100% { opacity: 1; transform: translateY(0); } }\n  @keyframes logoCycleB { 0%,42% { opacity: 0; transform: translateY(14px); } 50%,92% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(14px); } }\n  summary { list-style: none; cursor: pointer; }\n  summary::-webkit-details-marker { display: none; }\n  details[open] [data-plus] { transform: rotate(45deg); }\n  [data-marquee]:hover > div { animation-play-state: paused; }\n  @keyframes listUp { from { transform: translateY(0); } to { transform: translateY(-50%); } }\n  @keyframes gaugeSweep { 0% { stroke-dashoffset: 283; } 58%, 90% { stroke-dashoffset: 62; } 100% { stroke-dashoffset: 283; } }\n  @keyframes needleSweep { 0% { transform: rotate(-68deg); } 58%, 90% { transform: rotate(46deg); } 100% { transform: rotate(-68deg); } }\n  @keyframes numStrip { 0% { transform: translateY(0); } 58%, 90% { transform: translateY(-116px); } 100% { transform: translateY(0); } }\n  @keyframes riseIn { 0% { opacity: 0; transform: translateY(10px); } 12%, 88% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(10px); } }\n  @keyframes badgePop { 0% { opacity: 0; transform: scale(.82); } 14%, 86% { opacity: 1; transform: scale(1); } 100% { op